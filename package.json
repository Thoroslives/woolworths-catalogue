{
  "name": "woolworths-catalogue",
  "version": "0.1.0",
  "description": "Read one Woolworths store's shelf: a product by stockcode, a category page, the stores near a postcode, a whole-store sweep to JSONL, and a search over the sweep. Unofficial.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "smoke": "tsx scripts/smoke.ts",
    "sweep": "tsx scripts/sweep.ts",
    "search": "tsx scripts/search.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
